{
  "name": "@chronos/client",
  "version": "0.0.0",
  "private": true,
  "description": "Expo app (Expo Router): web, iOS and Android from one codebase (ADR-0003)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start",
    "web": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli start --web",
    "export:web": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli export --platform web --output-dir dist-web",
    "export:native": "node --env-file-if-exists=../../.env node_modules/expo/bin/cli export --platform ios --platform android --output-dir dist-native",
    "e2e": "node e2e/build-web.mjs && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@chronos/contracts": "workspace:*",
    "@expo/metro-runtime": "58.0.16",
    "better-auth": "catalog:",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.15",
    "expo-network": "58.0.4",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chronos/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

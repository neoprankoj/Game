{
  "name": "chronos-cradle",
  "private": true,
  "description": "Chronos Cradle: Temporal Empires \u2014 persistent cross-platform grand strategy (monorepo)",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run depcruise",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:up": "node infrastructure/scripts/dev.mjs up",
    "dev:down": "node infrastructure/scripts/dev.mjs down",
    "dev:reset": "node infrastructure/scripts/dev.mjs reset",
    "dev:status": "node infrastructure/scripts/dev.mjs status",
    "dev:api": "pnpm --filter @chronos/api dev",
    "dev:workers": "pnpm --filter @chronos/workers dev",
    "dev:client": "pnpm --filter @chronos/client dev",
    "dev:web": "pnpm --filter @chronos/client web",
    "e2e": "pnpm --filter @chronos/client e2e",
    "db:generate": "pnpm --filter @chronos/db generate",
    "db:migrate": "pnpm --filter @chronos/db migrate",
    "db:seed": "pnpm --filter @chronos/db seed",
    "api:spec": "pnpm --filter @chronos/contracts openapi"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "@chronos/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling: tsconfig, ESLint, Vitest and dependency-cruiser rules",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./vitest": "./vitest/base.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./depcruise": "./depcruise/rules.cjs",
    "./build": "./build/bundle-app.mjs"

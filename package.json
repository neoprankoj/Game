{
  "name": "chronos-cradle",
  "private": true,
  "description": "Chronos Cradle: Temporal Empires — persistent cross-platform grand strategy (monorepo)",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run depcruise",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}

# =============================================================================
# Chronos Cradle — environment variables (copy to .env:  cp .env.example .env)
# =============================================================================
# Rule 16: no real secrets in the repository. The values below are LOCAL-DEVELOPMENT
# placeholders for services bound to 127.0.0.1 only. Staging/production values live in the
# hosting platform's settings (Part 2.10), never in git. Every variable the code reads is
# listed here; Parts that add variables extend this file in the same commit.

# --- Runtime ------------------------------------------------------------------
# development | test | production. Apps validate their environment with Zod at startup (2.5/2.6).
NODE_ENV=development

# --- PostgreSQL (local Docker, infrastructure/docker-compose.yml) -------------
# Used by docker compose to initialise the dev database.
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos_local_dev_only
POSTGRES_DB=chronos
# Separate database for integration tests (created on first start; Part 2.3).
POSTGRES_TEST_DB=chronos_test
# Host port (loopback only). Non-default to avoid clashing with a locally installed PostgreSQL.
POSTGRES_PORT=55432

# Connection strings used by the API, workers and tools (packages/db from Part 2.3).
DATABASE_URL=postgres://chronos:chronos_local_dev_only@127.0.0.1:55432/chronos
TEST_DATABASE_URL=postgres://chronos:chronos_local_dev_only@127.0.0.1:55432/chronos_test

# --- Redis (local Docker) -----------------------------------------------------
# Password required even locally (parity with production, ADR-0008).
REDIS_PASSWORD=chronos_local_dev_only
# Host port (loopback only). Non-default to avoid clashing with a locally installed Redis.
REDIS_PORT=56379
# Connection string used by workers/API (BullMQ from Part 2.6; database index 0).
REDIS_URL=redis://:chronos_local_dev_only@127.0.0.1:56379/0

{
  "extends": ["@chronos/config/tsconfig/base.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "types": ["expo/types"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "*.config.ts",
    "eslint.config.mjs"
  ]
}
